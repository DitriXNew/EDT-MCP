<!-- Eclipse -->
<location followRepositoryReferences="false" includeAllPlatforms="true" includeConfigurePhase="false" includeMode="slicer" includeSource="true" type="InstallableUnit">
<unit id="org.eclipse.sdk.feature.group" version="0.0.0"/>
<unit id="org.eclipse.platform.feature.group" version="0.0.0"/>
<unit id="org.eclipse.pde.feature.group" version="0.0.0"/>
<unit id="org.eclipse.orbit.xml-apis-ext" version="0.0.0"/>
<!-- Eclipse 4.38's org.eclipse.ui and org.eclipse.jface require the SWT capability
     eclipse.swt;(image.format=svg), which only this bundle provides. Without it the whole
     workbench stack fails to RESOLVE at runtime - the tycho-surefire test runtime included -
     while compilation still succeeds, so the symptom is a launch that dies, not a build error. -->
<unit id="org.eclipse.swt.svg" version="0.0.0"/>
<!-- EDT's mobiledigisign requires jakarta.xml.bind-api [2.3.3,3.0.0); the release also
     publishes 4.0.4, which a 0.0.0 range would pick instead, so the 2.x line is named.
     javax.activation is what that 2.x line imports; both are shipped by EDT itself. -->
<unit id="jakarta.xml.bind-api" version="2.3.3"/>
<unit id="javax.activation" version="0.0.0"/>
<!-- org.eclipse.osgi.services, which EGit pulls in, requires all of these as BUNDLES, and the
     slicer follows no requirement of its own accord. The 2023-12 platform still folded these
     packages into org.eclipse.osgi.services itself; 2025-12 splits them out. -->
<unit id="org.osgi.service.http.whiteboard" version="0.0.0"/>
<unit id="org.eclipse.equinox.http.service.api" version="0.0.0"/>
<unit id="org.osgi.service.cm" version="0.0.0"/>
<unit id="org.osgi.service.component" version="0.0.0"/>
<unit id="org.osgi.service.device" version="0.0.0"/>
<unit id="org.osgi.service.event" version="0.0.0"/>
<unit id="org.osgi.service.metatype" version="0.0.0"/>
<unit id="org.osgi.service.provisioning" version="0.0.0"/>
<unit id="org.osgi.service.upnp" version="0.0.0"/>
<unit id="org.osgi.service.useradmin" version="0.0.0"/>
<unit id="org.osgi.service.wireadmin" version="0.0.0"/>
<unit id="org.eclipse.ecf.provider.filetransfer.httpclientjava" version="0.0.0"/>
<repository id="eclipse_repository" location="https://download.eclipse.org/releases/2025-12/"/>
</location>

<location followRepositoryReferences="false" includeAllPlatforms="true" includeConfigurePhase="false" includeMode="slicer" includeSource="true" type="InstallableUnit">
<unit id="org.eclipse.license.feature.group" version="0.0.0"/>
