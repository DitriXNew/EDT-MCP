<project
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
  xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.ditrix.edt.mcp</groupId>
  <artifactId>bom</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>BOM</name>

  <prerequisites>
    <maven>3.9.4</maven>
  </prerequisites>

  <properties>
    <!--
      Tycho 5 is required by the target platform, not by taste: EDT 2026.2 ships class files of
      major version 69 (Java 25), and the ECJ inside Tycho 4.0.x (3.36) cannot read them. Tycho
      5.0.4 carries ECJ 3.46, and needs Maven on JDK 21+ to run - the JDK that RUNS the build,
      not the level this bundle compiles to, which stays 17 (see tycho-compiler-plugin below).
    -->
    <tycho.version>5.0.4</tycho.version>
    <tycho.extras.version>5.0.4</tycho.extras.version>

    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <maven.compiler.release>17</maven.compiler.release>

    <maven.build.timestamp.format>'v'yyyyMMdd-HHmm</maven.build.timestamp.format>
    <qualifier>${maven.build.timestamp}</qualifier>

    <!-- Performance optimizations -->
    <tycho.localArtifacts>ignore</tycho.localArtifacts>
    <tycho.resolver.classic>false</tycho.resolver.classic>
    <tycho.baseline.skip>true</tycho.baseline.skip>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.eclipse.tycho</groupId>
          <artifactId>target-platform-configuration</artifactId>
          <version>${tycho.version}</version>
          <configuration>
            <!--
              RESOLUTION environment only. EDT 2026.2's bundles require osgi.ee JavaSE-25, so a
              JavaSE-17 context cannot satisfy them - and dropping the constraint instead removes
              the JRE provider altogether, which satisfies nothing. What the plugin COMPILES to is
              set separately, and stays 17: tycho-compiler-plugin below pins release 17, and
              MANIFEST.MF keeps Bundle-RequiredExecutionEnvironment JavaSE-17, so one artifact
              still installs on EDT 2026.1 (Eclipse 4.30 / Java 17).
            -->
            <executionEnvironment>JavaSE-25</executionEnvironment>
            <target>
              <artifact>
                <groupId>com.ditrix.edt.mcp</groupId>
                <artifactId>default</artifactId>
                <version>1.0.0-SNAPSHOT</version>
              </artifact>
            </target>
            <dependency-resolution>
              <extraRequirements>
                <requirement>
                  <type>eclipse-plugin</type>
                  <id>org.apache.felix.scr</id>
                  <versionRange>0.0.0</versionRange>
                </requirement>
                <requirement>
                  <type>eclipse-plugin</type>
                  <id>org.apache.aries.spifly.dynamic.bundle</id>
                  <versionRange>1.3.7</versionRange>
                </requirement>
                <!--
                  Nothing REQUIRES this bundle by name: org.eclipse.ui and org.eclipse.jface (4.38)
                  ask for the capability eclipse.swt;(image.format=svg), and only this bundle
                  offers it. A capability provider is not part of anyone's dependency closure, so
                  the test runtime was assembled without it and the whole workbench stack failed
                  to resolve at launch while the compile stayed green.
                -->
                <requirement>
                  <type>eclipse-plugin</type>
                  <id>org.eclipse.swt.svg</id>
                  <versionRange>0.0.0</versionRange>
                </requirement>
              </extraRequirements>
            </dependency-resolution>
            <environments>
              <environment>
                <os>win32</os>
                <ws>win32</ws>
                <arch>x86_64</arch>
              </environment>
              <environment>
                <os>linux</os>
                <ws>gtk</ws>
                <arch>x86_64</arch>
              </environment>
              <environment>
                <os>macosx</os>
                <ws>cocoa</ws>
                <arch>x86_64</arch>
              </environment>
            </environments>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.eclipse.tycho</groupId>
          <artifactId>tycho-maven-plugin</artifactId>
          <version>${tycho.version}</version>
          <extensions>true</extensions>
        </plugin>
        <plugin>
          <groupId>org.eclipse.tycho</groupId>
          <artifactId>tycho-compiler-plugin</artifactId>
          <version>${tycho.version}</version>
          <configuration>
            <!--
              The bytecode level, kept apart from the resolution environment above: the target
              platform is Java 25, this bundle is Java 17. Both supported EDTs can then load one
              artifact - 2026.1 runs Java 17 - and no Java 18+ API can slip in, because release
              (unlike source/target) also restricts the JDK API surface the compiler offers.
            -->
            <release>17</release>
            <encoding>UTF-8</encoding>
            <strictCompilerTarget>true</strictCompilerTarget>
            <useProjectSettings>true</useProjectSettings>
            <showWarnings>true</showWarnings>
            <showDeprecation>true</showDeprecation>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.eclipse.tycho</groupId>
          <artifactId>tycho-source-plugin</artifactId>
          <version>${tycho.version}</version>
          <configuration>
            <archive>
              <addMavenDescriptor>false</addMavenDescriptor>
            </archive>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>plugin-source</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.eclipse.tycho</groupId>
          <artifactId>tycho-packaging-plugin</artifactId>
          <version>${tycho.version}</version>
          <configuration>
            <archive>
              <addMavenDescriptor>false</addMavenDescriptor>
            </archive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.eclipse.tycho</groupId>
          <artifactId>tycho-p2-repository-plugin</artifactId>
          <version>${tycho.version}</version>
          <configuration>
            <repositoryName>${project.name} Repository</repositoryName>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-maven-plugin</artifactId>
        <extensions>true</extensions>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
